{
  "manifest_version": 1,
  "id": "cdp-pilot",
  "name": "CDP Pilot",
  "version": "0.1.0",
  "description": "Seed placeholder for cdp-pilot: drive a configured Electron/Chromium app over CDP on a linked remote host. Implementation lands in the first PR.",
  "tier": "inprocess",
  "requires_ui_refresh": true,
  "publisher": "TekFlox",
  "resource_estimate": {
    "cpu": "low",
    "memory": "low",
    "disk": "low"
  },
  "runtime": {
    "python": ">=3.11",
    "entrypoint": "template_app.plugin:TemplateAppPlugin",
    "pip_requires": [],
    "standalone": {
      "module": "template_app",
      "default_port": 9400
    }
  },
  "permissions": [
    "commands:install",
    "fs:workspace-data",
    "routes:register",
    "ui:code",
    "ui:slots:core.nav",
    "notifications:send"
  ],
  "contributes": {
    "system_clis": [
      {
        "name": "template",
        "installer": "scripts/install_template.sh",
        "verify": "template --version"
      }
    ],
    "routes": [
      {
        "prefix": "/api/apps/cdp-pilot"
      }
    ],
    "windows": [
      {
        "id": "cdp-pilot.reference",
        "title": "App Event Reference",
        "body": {
          "type": "managed_app",
          "app_id": "cdp-pilot",
          "url": "/api/apps/cdp-pilot/template"
        }
      }
    ],
    "event_hooks": [
      {
        "event": "reference_open",
        "action": {
          "type": "open_window",
          "window": "cdp-pilot.reference"
        }
      }
    ],
    "frontend": {
      "mode": "component",
      "bundle": "ui/dist/template.js"
    },
    "skills": [
      {
        "id": "aw-create-app",
        "path": "skills/aw-create-app/SKILL.md",
        "description": "How to author a decoupled aw-workspace app from this template \u2014 manifest, tiers, capabilities, contributes, backend routes (HTTP+WS), frontend code, standalone mode, window widgets, install + marketplace release."
      }
    ],
    "knowledge": {
      "path": "docs"
    }
  },
  "config_schema": {
    "type": "object",
    "properties": {
      "greeting": {
        "type": "string",
        "default": "Hello",
        "description": "Word the installed `template` command prints before the target name, e.g. \"Hello, world!\"."
      }
    },
    "required": []
  },
  "config_visible": false,
  "dependencies": {},
  "migrations": {}
}
